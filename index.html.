<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes"><meta name="mobile-web-app-capable" content="yes"><meta name="theme-color" content="#4aa52e">
<title>Договор Платона — трекер</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Nunito:wght@600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#e9f1dc;--card:#fff;--ink:#1d2a17;--mute:#5d6b53;--line:#c9d8b6;--grass:#4aa52e;--grass-d:#2f7a1b;--gold:#f2b600;--red:#d93a3a;--redbg:#fde8e6;--sel:#1d2a17;--selt:#fff;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#12162a;--card:#1c2240;--ink:#eef2ff;--mute:#9aa6d0;--line:#323b6b;--grass:#63d144;--grass-d:#8cf070;--gold:#ffd23f;--red:#ff6b6b;--redbg:#3a1f2b;--sel:#ffd23f;--selt:#12162a}}
:root[data-theme="dark"]{--bg:#12162a;--card:#1c2240;--ink:#eef2ff;--mute:#9aa6d0;--line:#323b6b;--grass:#63d144;--grass-d:#8cf070;--gold:#ffd23f;--red:#ff6b6b;--redbg:#3a1f2b;--sel:#ffd23f;--selt:#12162a}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Nunito,system-ui,sans-serif;font-weight:600;line-height:1.35}
main{max-width:640px;margin:0 auto;padding:14px 14px 40px}
h1,h2,.px{font-family:'Press Start 2P',monospace;font-weight:400}
h1{font-size:15px;line-height:1.5;margin:6px 0 12px}
h2{font-size:11px;line-height:1.6;margin:22px 0 8px;color:var(--grass-d)}
.days{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px}
.day{flex:1;min-width:46px;border:2px solid var(--line);background:var(--card);color:var(--ink);border-radius:8px;padding:6px 2px;font:inherit;font-weight:800;font-size:13px;cursor:pointer;text-align:center}
.day small{display:block;font-size:11px;color:var(--mute);font-weight:600}
.day[aria-pressed=true]{background:var(--sel);color:var(--selt);border-color:var(--sel)}
.day[aria-pressed=true] small{color:inherit}
.hero{background:var(--card);border:3px solid var(--ink);border-radius:6px;padding:14px;margin-top:12px;box-shadow:5px 5px 0 var(--ink)}
.big{font-family:'Press Start 2P',monospace;font-size:34px;color:var(--grass-d);line-height:1.2}
.big span{font-size:12px;color:var(--mute);margin-left:6px}
.bar{height:16px;background:var(--line);border-radius:3px;margin:10px 0 6px;overflow:hidden;border:2px solid var(--ink)}
.bar i{display:block;height:100%;background:repeating-linear-gradient(90deg,var(--grass) 0 12px,var(--grass-d) 12px 14px);width:0;transition:width .3s}
.meta{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;font-size:13px;color:var(--mute)}
.play{display:flex;align-items:center;gap:8px;margin-top:10px;flex-wrap:wrap}
.play b{flex:1;min-width:120px}
.btn{border:2px solid var(--ink);background:var(--gold);color:#1d2a17;border-radius:6px;font:inherit;font-weight:800;padding:8px 12px;cursor:pointer;min-height:40px}
.btn.ghost{background:var(--card);color:var(--ink)}
.ban{display:none;background:var(--redbg);border:2px solid var(--red);color:var(--red);border-radius:6px;padding:10px;margin-top:10px;font-weight:800}
.ban.on{display:block}
.task{display:flex;align-items:center;gap:10px;width:100%;text-align:left;background:var(--card);color:var(--ink);border:2px solid var(--line);border-radius:8px;padding:10px 12px;margin-bottom:6px;font:inherit;cursor:pointer;min-height:48px;position:relative}
.task .box{flex:none;width:26px;height:26px;border:3px solid var(--ink);border-radius:4px;display:grid;place-items:center;font-size:18px;line-height:1}
.task .t{flex:1;font-size:15px}
.task .t small{display:block;color:var(--mute);font-weight:600;font-size:12px}
.task .p{font-family:'Press Start 2P',monospace;font-size:10px;color:var(--grass-d);white-space:nowrap}
.task[aria-pressed=true]{border-color:var(--grass);background:color-mix(in srgb,var(--grass) 14%,var(--card))}
.task[aria-pressed=true] .box{background:var(--grass);border-color:var(--grass-d);color:#fff}
.task[aria-pressed=true] .box::after{content:"✓"}
.task.neg .p{color:var(--red)}
.task.neg[aria-pressed=true]{border-color:var(--red);background:var(--redbg)}
.task.neg[aria-pressed=true] .box{background:var(--red);border-color:var(--red)}
.pop{position:absolute;right:14px;top:4px;font-family:'Press Start 2P',monospace;font-size:11px;color:var(--grass-d);pointer-events:none;animation:pop .8s ease-out forwards}
@keyframes pop{to{transform:translateY(-26px);opacity:0}}
@media (prefers-reduced-motion:reduce){.pop{animation:none;opacity:0}.bar i{transition:none}}
.week{background:var(--card);border:2px solid var(--line);border-radius:8px;padding:12px}
.wrow{display:grid;grid-template-columns:34px 1fr 64px;gap:8px;align-items:center;margin:5px 0;font-size:13px}
.wbar{height:12px;background:var(--line);border-radius:3px;overflow:hidden}
.wbar i{display:block;height:100%;background:var(--grass)}
.wrow.b .wbar i{background:var(--red)}
.wrow span:last-child{text-align:right}
.prem{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.prem .btn[aria-pressed=true]{background:var(--sel);color:var(--selt)}
.note{font-size:12px;color:var(--mute);margin-top:18px}
.top{display:flex;justify-content:space-between;align-items:center;gap:8px}
.lvl{display:flex;align-items:center;gap:12px;background:var(--card);border:2px solid var(--line);border-radius:8px;padding:10px 12px;margin-bottom:10px}
.lv{background:var(--gold);color:#1d2a17;border:2px solid var(--ink);border-radius:6px;padding:10px 8px;font-size:11px;white-space:nowrap}
.lr{flex:1;min-width:0}.lr small{color:var(--mute);font-size:12px}
.bar.sm{height:10px;margin:4px 0 2px}
.st{font-weight:800;text-align:center;font-size:12px;white-space:nowrap}.st b{display:block;font-size:20px}
.badges{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:8px}
.bd{background:var(--card);border:2px solid var(--line);border-radius:8px;padding:8px 4px;text-align:center;opacity:.5;filter:grayscale(1)}
.bd.on{opacity:1;filter:none;border-color:var(--gold)}
.bd i{display:block;font-style:normal;font-size:28px}
.bd b{display:block;font-size:12px}
.bd small{color:var(--mute);font-size:11px;display:block;line-height:1.2}
#toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:8px;font-weight:800;opacity:0;transition:.25s;pointer-events:none;z-index:9;max-width:90vw;text-align:center}
#toast.on{opacity:1;transform:translate(-50%,0)}
.btn.rep{width:100%;font-size:16px;min-height:52px}
.dad{margin-top:10px;background:var(--card);border:2px solid var(--line);border-radius:8px;padding:10px}.dad summary{font-weight:800;cursor:pointer}.dad textarea{width:100%;margin:8px 0;font:inherit;border:2px solid var(--line);border-radius:6px;padding:8px;background:var(--bg);color:var(--ink)}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
</style>
</head>
<body>
<main>
<div class="top"><h1>⛏ Договор Платона</h1><div><button class="btn ghost" id="snd" aria-label="Звук">🔊</button> <button class="btn ghost" id="theme" aria-label="Сменить тему">◐</button></div></div>
<section class="lvl"><div class="lv px" id="lv">Ур. 1</div><div class="lr"><b id="rank">Новичок</b><div class="bar sm"><i id="xpfill"></i></div><small id="xptxt">0 / 150 XP</small></div><div class="st" id="streak"><b>🔥 0</b>дн. подряд</div></section>
<div class="days" id="days"></div>

<section class="hero" aria-live="polite">
  <div class="big"><b id="avail">0</b><span>мин. игр на сегодня</span></div>
  <div class="bar"><i id="fill"></i></div>
  <div class="meta"><span>Заработано: <b id="earned">0</b></span><span>Лимит: 120 мин.</span></div>
  <div class="play">
    <b>Осталось поиграть: <span id="left">0</span> мин.</b>
    <button class="btn ghost" id="m15">−15 сыграл</button>
    <button class="btn ghost" id="p15">+15</button>
  </div>
  <div class="ban" id="ban">⛔ Сегодня без игр. Завтра новый день — правда безопасна.</div>
</section>

<div id="lists"></div>

<h2>Вечерний отчёт</h2>
<button class="btn rep" id="rep">📤 Отправить отчёт папе</button>

<details class="dad"><summary>Для папы: загрузить отчёт Платона</summary><textarea id="imp" rows="4" placeholder="Вставь сюда сообщение от Платона целиком"></textarea><button class="btn" id="impb">Загрузить</button></details>

<h2>Достижения</h2>
<div class="badges" id="ach"></div>

<h2>Неделя</h2>
<div class="week">
  <div id="week"></div>
  <div style="margin-top:10px">Всего за неделю: <b id="wtotal">0</b> мин.</div>
  <div style="margin-top:10px">Премия (решает папа, до 25 ₽):</div>
  <div class="prem" id="prem"></div>
</div>

<p class="note">Играть можно в Minecraft и Brawl Stars. Телевизор и телефон выключаются в 22:00 в будни. Данные хранятся в этом браузере.</p>
</main>
<div id="toast" role="status"></div>

<script>
const GROUPS=[
 {t:'Каждый день',items:[
  ['teeth','Почистил зубы без напоминания',15],
  ['trash','Вынес мусор без напоминания',15],
  ['fiz','Физкультура 30/30/30',20],
  ['hw','Уроки: черновик → проверка → чистовик',20],
  ['vb','Сам пошёл на волейбол',30],
  ['room','Убрал комнату',25],
  ['dish','Убрал свою посуду',5],
  ['rep','Вечерний отчёт вслух',10,'Уроки, обязанности, физкультура, уборка']]},
 {t:'Оценки',items:[
  ['g8','Оценка 8–10 из 10',30,'3–7 из 10 — 0 минут'],
  ['gh','Честно сказал о плохой оценке',5]]},
 {t:'Новые обязанности',items:[
  ['cook','Приготовил простую еду (будни)',20,'Считается, только если убрал за собой'],
  ['vac','Пропылесосил свою зону',20],
  ['dw','Загрузил или разгрузил посудомойку',15,'Без напоминания'],
  ['toys','Убрал игрушки после гостей',15],
  ['tbl','Убрал стол после еды',10]]},
 {t:'Телевизор',items:[
  ['sci','Познавательная передача: история, наука, природа',15,'ТВ максимум 1,5 часа в день']]},
 {t:'Нарушения',neg:true,items:[
  ['ng','Не сказал про оценку',-30],
  ['ig','Игнорировал договор',-60],
  ['nd','Не выполнил обязанность',-30],
  ['lie','Соврал (в том числе про оценку)',0,'Один день без игр',1],
  ['tv','Нарушил правила ТВ или телефона',0,'Один день без игр',1]]}
];
const DN=['Пн','Вт','Ср','Чт','Пт','Сб','Вс'],MAX=120;
let S={days:{},prem:{},ach:[],lvl:1};
try{S=JSON.parse(localStorage.getItem('platon-v1'))||S}catch(e){}
S.ach=S.ach||[];S.lvl=S.lvl||1;
const RANKS=['Новичок','Дровосек','Шахтёр','Кузнец','Искатель алмазов','Рыцарь','Защитник','Легенда'];
const xpAt=n=>75*n*(n-1);
const good=k=>{const c=calc(k);return !c.ban&&c.total>=60};
const dd=(a,b)=>Math.round((new Date(b)-new Date(a))/864e5);
const ACH=[
 ['f','⛏','Первая галочка','Отметь любое дело',s=>s.n>0],
 ['full','💎','Полный день','Набери 120 минут за день',s=>s.full],
 ['h','🤝','Честный','Сказать про плохую оценку 3 раза',s=>(s.cnt.gh||0)>=3],
 ['v','🏐','Спортсмен','Сам пойти на волейбол 4 раза',s=>(s.cnt.vb||0)>=4],
 ['r','🧹','Чистюля','Убрать комнату 5 раз',s=>(s.cnt.room||0)>=5],
 ['c','🍳','Повар','Приготовить еду 3 раза',s=>(s.cnt.cook||0)>=3],
 ['k','📚','Знаток','3 познавательные передачи',s=>(s.cnt.sci||0)>=3],
 ['s3','🔥','Серия 3','3 хороших дня подряд',s=>s.best>=3],
 ['s7','🏆','Неделя без срывов','7 хороших дней подряд',s=>s.best>=7],
 ['l5','👑','Уровень 5','Дорасти до 5 уровня',s=>s.lvl>=5]];
function stats(){
  let xp=0,n=0,full=false;const cnt={};
  const keys=Object.keys(S.days).sort();
  keys.forEach(k=>{const c=calc(k);if(!c.ban&&c.total>=120)full=true;
    S.days[k].done.forEach(id=>{const i=ALL[id];if(!i)return;n++;cnt[id]=(cnt[id]||0)+1;if(i[2]>0)xp+=i[2]})});
  let best=0,run=0,prev=null;
  keys.forEach(k=>{if(good(k)){run=(prev&&dd(prev,k)===1)?run+1:1;best=Math.max(best,run);prev=k}else{run=0;prev=null}});
  let k=new Date(today);if(!good(ymd(k)))k.setDate(k.getDate()-1);
  let cur=0;while(good(ymd(k))){cur++;k.setDate(k.getDate()-1)}
  let lvl=1;while(xp>=xpAt(lvl+1))lvl++;
  return{xp,n,full,cnt,best,cur,lvl};
}
function renderLvl(){
  const t=stats(),a=xpAt(t.lvl),b=xpAt(t.lvl+1);
  $('lv').textContent='Ур. '+t.lvl;$('rank').textContent=RANKS[Math.min(t.lvl-1,RANKS.length-1)];
  $('xpfill').style.width=((t.xp-a)/(b-a)*100)+'%';$('xptxt').textContent=t.xp+' / '+b+' XP';
  $('streak').innerHTML='<b>🔥 '+t.cur+'</b>дн. подряд';
  $('ach').innerHTML=ACH.map(x=>{const on=S.ach.includes(x[0])||x[4](t);return `<div class="bd${on?' on':''}"><i>${on?x[1]:'🔒'}</i><b>${x[2]}</b><small>${x[3]}</small></div>`}).join('');
  return t;
}
let AC,tt;
function toast(m){const e=$('toast');e.textContent=m;e.classList.add('on');clearTimeout(tt);tt=setTimeout(()=>e.classList.remove('on'),3000)}
function fx(kind){
  try{navigator.vibrate&&navigator.vibrate(kind==='neg'?[60,40,60]:kind==='win'?[40,60,40,60,120]:25)}catch(e){}
  if(S.snd===false)return;
  try{AC=AC||new(window.AudioContext||window.webkitAudioContext)();const n=AC.currentTime;
    const q={ok:[660,880],neg:[220,160],win:[523,659,784,1047]}[kind];
    q.forEach((f,i)=>{const o=AC.createOscillator(),g=AC.createGain();o.type='square';o.frequency.value=f;
      g.gain.setValueAtTime(.07,n+i*.1);g.gain.exponentialRampToValueAtTime(.001,n+i*.1+.12);
      o.connect(g);g.connect(AC.destination);o.start(n+i*.1);o.stop(n+i*.1+.13)})}catch(e){}
}
function checkAch(){
  const t=renderLvl();let msg=[];
  if(t.lvl>S.lvl){S.lvl=t.lvl;msg.push('Новый уровень '+t.lvl+'! '+RANKS[Math.min(t.lvl-1,7)])}
  ACH.forEach(x=>{if(x[4](t)&&!S.ach.includes(x[0])){S.ach.push(x[0]);msg.push(x[1]+' '+x[2])}});
  if(msg.length){save();toast(msg.join(' · '));setTimeout(()=>fx('win'),150)}
}
function save(){try{localStorage.setItem('platon-v1',JSON.stringify(S))}catch(e){}}
const ymd=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const today=new Date();
const mon=new Date(today);mon.setDate(today.getDate()-((today.getDay()+6)%7));
const week=[...Array(7)].map((_,i)=>{const d=new Date(mon);d.setDate(mon.getDate()+i);return d});
let cur=ymd(today);
const ALL={};GROUPS.forEach(g=>g.items.forEach(i=>ALL[i[0]]=i));
const $=id=>document.getElementById(id);
const D=k=>S.days[k]||(S.days[k]={done:[],played:0});
function calc(k){
  const d=S.days[k]||{done:[],played:0};let e=0,ban=false;
  d.done.forEach(id=>{const i=ALL[id];if(!i)return;e+=i[2];if(i[4])ban=true});
  const total=Math.max(0,e),avail=ban?0:Math.min(total,MAX);
  return{total,avail,ban,left:Math.max(0,avail-d.played),played:d.played};
}
function renderDays(){
  $('days').innerHTML=week.map(d=>{const k=ymd(d);return `<button class="day" data-k="${k}" aria-pressed="${k===cur}">${DN[(d.getDay()+6)%7]}<small>${d.getDate()}</small></button>`}).join('');
}
function renderLists(){
  const d=D(cur);
  $('lists').innerHTML=GROUPS.map(g=>`<h2>${g.t}</h2>`+g.items.map(i=>{
    const on=d.done.includes(i[0]);
    const p=i[2]>0?'+'+i[2]:i[2]<0?i[2]:'⛔';
    return `<button class="task${g.neg?' neg':''}" data-id="${i[0]}" aria-pressed="${on}"><span class="box"></span><span class="t">${i[1]}${i[3]?`<small>${i[3]}</small>`:''}</span><span class="p">${p}</span></button>`}).join('')).join('');
}
function renderTop(){
  const c=calc(cur);
  $('avail').textContent=c.avail;$('earned').textContent=c.total;$('left').textContent=c.left;
  $('fill').style.width=Math.min(100,c.avail/MAX*100)+'%';
  $('ban').classList.toggle('on',c.ban);
}
function renderWeek(){
  let tot=0;
  $('week').innerHTML=week.map(d=>{const k=ymd(d),c=calc(k);tot+=c.avail;
    return `<div class="wrow${c.ban?' b':''}"><span>${DN[(d.getDay()+6)%7]}</span><div class="wbar"><i style="width:${c.ban?100:c.avail/MAX*100}%"></i></div><span>${c.ban?'⛔':c.avail+' мин'}</span></div>`}).join('');
  $('wtotal').textContent=tot;
  const wk=ymd(mon),v=S.prem[wk]||0;
  $('prem').innerHTML=[0,5,10,15,20,25].map(n=>`<button class="btn" data-p="${n}" aria-pressed="${v===n}">${n} ₽</button>`).join('');
}
function all(){renderDays();renderLists();renderTop();renderWeek();renderLvl();$('snd').textContent=S.snd===false?'🔇':'🔊'}
$('days').onclick=e=>{const b=e.target.closest('.day');if(b){cur=b.dataset.k;all()}};
$('lists').onclick=e=>{
  const b=e.target.closest('.task');if(!b)return;
  const id=b.dataset.id,d=D(cur),i=d.done.indexOf(id),it=ALL[id];
  if(i>=0)d.done.splice(i,1);else{d.done.push(id);
    if(it[2]!==0){const s=document.createElement('span');s.className='pop';s.textContent=(it[2]>0?'+':'')+it[2];s.style.color=it[2]<0?'var(--red)':'';b.appendChild(s)}}
  save();b.setAttribute('aria-pressed',i<0);renderTop();renderWeek();if(i<0)fx(it[2]<0||it[4]?'neg':'ok');checkAch();
};
$('p15').onclick=()=>{const d=D(cur);d.played=Math.min(MAX,d.played+15);save();renderTop()};
$('m15').onclick=()=>{const d=D(cur);d.played=Math.max(0,d.played-15);save();renderTop()};
$('prem').onclick=e=>{const b=e.target.closest('[data-p]');if(!b)return;S.prem[ymd(mon)]=+b.dataset.p;save();renderWeek()};
$('rep').onclick=async()=>{
  const d=D(cur),c=calc(cur),t=stats(),dt=new Date(cur+'T12:00:00');
  const L=ids=>ids.map(id=>ALL[id][1]).join(', ')||'нет';
  const pos=d.done.filter(id=>ALL[id][2]>0),neg=d.done.filter(id=>ALL[id][2]<=0);
  const txt=`Отчёт Платона, ${DN[(dt.getDay()+6)%7]} ${dt.getDate()}.${String(dt.getMonth()+1).padStart(2,'0')}\n`+
   `Заработано: ${c.total} мин., доступно: ${c.avail}, сыграл: ${c.played}, осталось: ${c.left}\n`+
   `Сделано: ${L(pos)}\nНарушения: ${L(neg)}${c.ban?'\nСегодня без игр':''}\n`+
   `Уровень ${t.lvl}, серия: ${t.cur} дн.\nКод: PT1|${cur}|${d.done.join('.')}|${d.played}`;
  try{if(navigator.share){await navigator.share({text:txt});return}}catch(e){if(e&&e.name==='AbortError')return}
  try{await navigator.clipboard.writeText(txt);toast('Отчёт скопирован. Вставь его в чат с папой')}
  catch(e){prompt('Скопируй отчёт и отправь папе:',txt)}
};
$('impb').onclick=()=>{
  const m=/PT1\|(\d{4}-\d\d-\d\d)\|([a-z0-9.]*)\|(\d{1,3})/.exec($('imp').value);
  if(!m){toast('Код отчёта не найден. Вставь сообщение целиком');return}
  const ids=m[2].split('.').filter(x=>Object.prototype.hasOwnProperty.call(ALL,x));
  S.days[m[1]]={done:ids,played:Math.min(MAX,+m[3])};
  save();$('imp').value='';
  if(week.some(d=>ymd(d)===m[1]))cur=m[1];
  all();checkAch();toast('Отчёт за '+m[1]+' загружен');
};
$('snd').onclick=()=>{S.snd=S.snd===false;save();$('snd').textContent=S.snd===false?'🔇':'🔊';fx('ok')};
$('theme').onclick=()=>{const r=document.documentElement,dark=getComputedStyle(r).getPropertyValue('--bg').trim()==='#12162a';r.dataset.theme=dark?'light':'dark'};
all();checkAch();
</script>
